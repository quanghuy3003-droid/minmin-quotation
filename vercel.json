{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/drive-upload.js": {
      "maxDuration": 60
    },
    "api/image-proxy.js": {
      "maxDuration": 30
    },
    "api/drive-state.js": {
      "maxDuration": 60
    },
    "api/woo-image.js": {
      "maxDuration": 60
    },
    "api/excel-to-pdf.js": {
      "maxDuration": 60
    },
    "api/app-version.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/woo-image/:file",
      "destination": "/api/woo-image?file=:file"
    },
    {
      "source": "/",
      "destination": "/index"
    }
  ]
}
