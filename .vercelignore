# Deploy only the static app, its browser libraries, and the required API functions.
# In particular, server.mjs is for local Windows use and must never be detected
# as the production entrypoint by Vercel.
/*
!/api/
!/vendor/
!/assets/
!/index.html
!/vercel.json

/api/*
!/api/drive-upload.js
!/api/image-proxy.js
!/api/drive-state.js
!/api/woo-image.js
!/api/excel-to-pdf.js
